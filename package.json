{
  "name": "polskiebudownictwo",
  "version": "1.0.0",
  "private": true,
  "description": "Strona inicjatywy Polskie Budownictwo",
  "main": "app.js",
  "scripts": {
    "dev": "node --watch --watch-path=page --watch-path=views --watch-path=public --watch-path=controllers --watch-path=models --watch-path=routes --watch-path=services --watch-path=modules server.js",
    "watch": "node --watch --watch-path=page --watch-path=views --watch-path=public --watch-path=controllers --watch-path=models --watch-path=routes --watch-path=services --watch-path=modules server.js",
    "serve": "node server.js",
    "start": "node --watch --watch-path=page --watch-path=views --watch-path=public --watch-path=controllers --watch-path=models --watch-path=routes --watch-path=services app.js",
    "start:prod": "node app.js",
    "mediacje": "node --watch --watch-path=subdomain/mediacje --watch-path=app-mediacje.js scripts/runMediacje.js",
    "dev:mediacje": "node --watch --watch-path=subdomain/mediacje --watch-path=app-mediacje.js scripts/runMediacje.js",
    "mediacje:dist": "npm run build:mediacje && node dists/mediacje.polskiebudownictwo.org/app.js",
    "migrate": "node scripts/migrate.js",
    "migrate:mediators": "node scripts/migrateMediators.js",
    "migrate:mediator-profile": "node scripts/migrateMediatorProfile.js",
    "create-superadmin": "node scripts/createSuperadmin.js",
    "cleanup-unverified-users": "node scripts/cleanupUnverifiedUsers.js",
    "reset-admin-password": "node scripts/resetAdminPassword.js",
    "test:smtp": "node scripts/testSmtp.js",
    "build:main": "node scripts/buildDeployPackage.js main",
    "build:mediacje": "node scripts/buildDeployPackage.js mediacje",
    "build:deploy": "node scripts/buildDeployPackage.js",
    "dist": "node scripts/buildDeployPackage.js",
    "cleanup-files": "node scripts/cleanupFiles.js",
    "test:files": "node --test tests/files/*.test.js",
    "test:files:e2e": "node scripts/testFilesE2E.js",
    "migrate:files": "node scripts/migrateFiles.js",
    "files:check": "node scripts/checkFiles.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-flash": "^0.1.1",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "multer": "^2.3.0",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "quill": "^2.0.3",
    "saxes": "^6.0.0",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
