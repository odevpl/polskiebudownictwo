<div class="adm-rich-textarea" data-rich-textarea>
  <div class="adm-rich-textarea__input" data-rich-text-input aria-label="<%= label %>"></div>
  <textarea class="adm-rich-textarea__value" id="<%= id %>" name="<%= name %>" <%= required ? 'required' : '' %>><%= value || '' %></textarea>
  <p class="adm-rich-textarea__hint">Enter tworzy nowy akapit. Dostępne są pogrubienie, kursywa oraz listy.</p>
</div>
