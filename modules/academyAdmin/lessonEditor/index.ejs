<link rel="stylesheet" href="/assets/modules/academy-admin/lesson-content/editor.css?v=2">
<% if (!embedded) { %>
  <section class="admin-page">
    <a class="button button--ghost" href="<%= module ? adminUrl('/academy/modules/' + module.id + '/lessons') : adminUrl('/academy/courses/' + course.id + '/lessons') %>">Wróć do lekcji</a>
    <div class="admin-hero"><div class="admin-hero__art" aria-hidden="true">L</div><div><p class="adm-kicker"><%= mode === 'edit' ? 'Edycja lekcji' : 'Nowa lekcja' %></p><h1><%= mode === 'edit' ? ('Lekcja #' + lesson.id) : 'Dodaj lekcję' %></h1><p class="admin-hero__meta"><%= module ? module.title : course.title %></p></div></div>
<% } %>
  <% if (errors.length) { %><div class="adm-alert"><% errors.forEach(error => { %><div><%= error %></div><% }) %></div><% } %>
  <form class="adm-form" method="post" action="<%= action %>"><div class="adm-form-grid">
    <% if (embedded) { %><input type="hidden" name="workspace" value="1"><% } %>
    <div class="adm-field"><label class="adm-label" for="slug">Slug</label><input class="adm-control" id="slug" name="slug" value="<%= lesson.slug || '' %>" required></div>
    <div class="adm-field"><label class="adm-label" for="title">Tytuł lekcji</label><input class="adm-control" id="title" name="title" value="<%= lesson.title || '' %>" required></div>
    <input type="hidden" name="contentType" value="text">
    <div class="adm-field"><label class="adm-label" for="sortOrder">Kolejność</label><input class="adm-control" id="sortOrder" name="sortOrder" type="number" min="0" value="<%= lesson.sort_order ?? lesson.sortOrder ?? 0 %>"></div>
    <%- include('../lessonContentEditor/index') %>
    <label class="adm-check"><input name="isPublished" type="checkbox" value="1" <%= lesson.is_published || lesson.isPublished ? 'checked' : '' %>><span>Opublikowana</span></label>
    <div class="adm-form-actions adm-form-grid__full"><button class="button" type="submit">Zapisz lekcję</button><a class="button button--ghost" href="<%= embedded ? returnUrl : (module ? adminUrl('/academy/modules/' + module.id + '/lessons') : adminUrl('/academy/courses/' + course.id + '/lessons')) %>">Anuluj</a></div>
  </div></form>
  <% if (mode === 'edit') { %><form method="post" action="<%= adminUrl('/academy/lessons/' + lesson.id + '/delete') %>" onsubmit="return confirm('Usunąć lekcję?');"><% if (embedded) { %><input type="hidden" name="workspace" value="1"><% } %><button class="button button--ghost" type="submit">Usuń lekcję</button></form><% } %>
<% if (!embedded) { %></section><% } %>
<script type="module" src="/assets/modules/academy-admin/lesson-content/editor.js?v=3"></script>
