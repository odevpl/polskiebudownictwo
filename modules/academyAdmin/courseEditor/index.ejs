<section class="admin-page">
  <a class="button button--ghost" href="<%= adminUrl('/academy/courses') %>">Wróć do kursów</a>
  <div class="admin-hero"><div class="admin-hero__art" aria-hidden="true">A</div><div><p class="adm-kicker"><%= mode === 'edit' ? 'Edycja kursu' : 'Nowy kurs' %></p><h1><%= mode === 'edit' ? ('Kurs #' + course.id) : 'Dodaj kurs' %></h1></div></div>
  <% if (errors.length) { %><div class="adm-alert"><% errors.forEach(error => { %><div><%= error %></div><% }) %></div><% } %>
  <form class="adm-form" method="post" action="<%= action %>"><div class="adm-form-grid">
    <div class="adm-field"><label class="adm-label" for="slug">Slug</label><input class="adm-control" id="slug" name="slug" value="<%= course.slug || '' %>" required></div>
    <div class="adm-field"><label class="adm-label" for="title">Tytuł</label><input class="adm-control" id="title" name="title" maxlength="255" value="<%= course.title || '' %>" required></div>
    <div class="adm-field"><label class="adm-label" for="category">Kategoria</label><input class="adm-control" id="category" name="category" value="<%= course.category || '' %>"></div>
    <div class="adm-field adm-form-grid__full"><label class="adm-label" for="introVideoUrl">Film YouTube pod nagłówkiem kursu (opcjonalnie)</label><input class="adm-control" id="introVideoUrl" name="introVideoUrl" type="url" value="<%= course.intro_video_id ? 'https://www.youtube.com/watch?v=' + course.intro_video_id : '' %>" placeholder="https://www.youtube.com/watch?v=..."></div>
    <div class="adm-field adm-form-grid__full"><label class="adm-label" for="detailsUrl">Link „Przeczytaj więcej” (opcjonalnie)</label><input class="adm-control" id="detailsUrl" name="detailsUrl" type="url" value="<%= course.details_url || '' %>" placeholder="/akademia/bezpieczny-pod-wykonawca lub https://..."><p class="muted">Link zobaczą wyłącznie osoby, które nie mają jeszcze dostępu do kursu.</p></div>
    <div class="adm-field"><label class="adm-label" for="level">Poziom</label><input class="adm-control" id="level" name="level" value="<%= course.level || '' %>"></div>
    <div class="adm-field"><label class="adm-label" for="moduleCount">Planowana liczba modułów</label><input class="adm-control" id="moduleCount" name="moduleCount" type="number" min="0" step="1" value="<%= course.module_count ?? course.moduleCount ?? 0 %>"><p class="muted">Na karcie kursu będzie widoczna jako liczba dostępnych modułów / ta liczba.</p></div>
    <div class="adm-field"><label class="adm-label" for="priceAmount">Cena</label><input class="adm-control" id="priceAmount" name="priceAmount" type="number" min="0" step="0.01" value="<%= course.price_amount ?? course.priceAmount ?? 0 %>"></div>
    <div class="adm-field"><label class="adm-label" for="currency">Waluta</label><input class="adm-control" id="currency" name="currency" maxlength="3" value="<%= course.currency || 'PLN' %>"></div>
    <div class="adm-field adm-form-grid__full"><label class="adm-label" for="description">Opis</label><%- include('../richTextEditor/index', { id: 'description', name: 'description', label: 'Opis kursu', value: course.description, required: true }) %></div>
    <div class="adm-field"><label class="adm-label" for="sortOrder">Kolejność</label><input class="adm-control" id="sortOrder" name="sortOrder" type="number" min="0" value="<%= course.sort_order ?? course.sortOrder ?? 0 %>"></div>
    <label class="adm-check"><input name="isFree" type="checkbox" value="1" <%= course.is_free || course.isFree ? 'checked' : '' %>><span>Kurs darmowy</span></label>
    <label class="adm-check"><input name="isActive" type="checkbox" value="1" <%= course.is_active || course.isActive ? 'checked' : '' %>><span>Aktywne i widoczne</span></label>
    <div class="adm-form-actions adm-form-grid__full"><button class="button" type="submit">Zapisz kurs</button><a class="button button--ghost" href="<%= adminUrl('/academy/courses') %>">Anuluj</a><% if (mode === 'edit') { %><a class="button button--ghost" href="<%= adminUrl('/academy/courses/' + course.id + '/modules') %>">Zarządzaj modułami</a><% } %></div>
  </div></form>
  <% if (mode === 'edit') { %><form method="post" action="<%= adminUrl('/academy/courses/' + course.id + '/delete') %>" onsubmit="return confirm('Usunąć kurs i jego zawartość?');"><button class="button button--ghost" type="submit">Usuń kurs</button></form><% } %>
</section>
<link rel="stylesheet" href="/vendor/quill/quill.snow.css">
<script src="/vendor/quill/quill.js" defer></script><script src="/assets/modules/academy-admin/rich-text-textarea.js?v=1" defer></script>
