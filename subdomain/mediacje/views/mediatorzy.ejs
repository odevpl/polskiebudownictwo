<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/favicon-144x144.png" />
    <meta name="description" content="Lista mediatorów Centrum Mediacji Gospodarczych przy Fundacji Polskie Budownictwo." />
    <title>Lista mediatorów | Centrum Mediacji</title>
    <link rel="stylesheet" href="/global.css?v=1" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <div class="site-brand">
          <a class="site-logo" href="https://polskiebudownictwo.org/" aria-label="Polskie Budownictwo – strona główna">
            <img src="/assets/images/logo.png" alt="Polskie Budownictwo" />
          </a>
          <p class="site-breadcrumb">Centrum Mediacji Gospodarczych</p>
        </div>

        <button class="site-menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Otwórz menu">
          <span></span><span></span><span></span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Główna nawigacja">
          <div class="site-nav__dropdown">
            <button class="site-nav__dropdown-trigger" type="button" aria-expanded="false" aria-haspopup="true">Mediacje</button>
            <div class="site-nav__dropdown-menu">
              <a href="/#mediacje-gospodarcze">Mediacje gospodarcze</a>
              <a href="/#mediacje-inwestycyjne">Mediacje inwestycyjne</a>
              <a href="/mediatorzy" aria-current="page">Lista mediatorów</a>
            </div>
          </div>
          <a href="/#klauzula-mediacyjna">Klauzula mediacyjna</a>
          <a href="/baza-wiedzy">Baza wiedzy</a>
          <a href="https://polskiebudownictwo.org/o_fundacji.html">O fundacji</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="section mediator-directory" aria-labelledby="mediators-title">
        <div class="container">
          <header class="section-heading">
            <p class="eyebrow">Centrum Mediacji Gospodarczych</p>
            <h1 id="mediators-title">Lista mediatorów</h1>
            <p>Doświadczone osoby, które pomagają przedsiębiorcom rozwiązywać spory gospodarcze i inwestycyjne z zachowaniem relacji biznesowych.</p>
          </header>

          <% if (error) { %>
            <p class="alert"><%= error %></p>
          <% } else if (!mediators.length) { %>
            <p class="mediator-directory__empty">Lista mediatorów zostanie uzupełniona wkrótce.</p>
          <% } else { %>
            <div class="mediator-directory__list">
              <% mediators.forEach(mediator => { %>
                <article class="mediator-card">
                  <header class="mediator-card__header">
                    <h2><%= mediator.name %></h2>
                    <p class="mediator-card__short-description"><%= mediator.short_description %></p>
                  </header>

                  <div class="mediator-card__meta">
                    <% if (mediator.mediation_modes) { %>
                      <div><strong>Tryb mediacji</strong><span><%= mediator.mediation_modes %></span></div>
                    <% } %>
                    <% if (mediator.specializations) { %>
                      <div><strong>Specjalizacja</strong><span><%= mediator.specializations %></span></div>
                    <% } %>
                  </div>

                  <details class="mediator-card__details">
                    <summary>Czytaj więcej</summary>
                    <div class="mediator-card__body">
                      <% if (mediator.full_description) { %><div class="mediator-card__rich-text"><%- mediator.full_description %></div><% } %>
                      <% if (mediator.key_experience) { %><h3>Kluczowe doświadczenie</h3><div class="mediator-card__rich-text"><%- mediator.key_experience %></div><% } %>
                      <% if (mediator.qualifications) { %><h3>Uprawnienia</h3><p><%= mediator.qualifications %></p><% } %>
                    </div>
                  </details>
                </article>
              <% }) %>
            </div>
          <% } %>
        </div>
      </section>

      <section class="section section--primary join-cta" aria-labelledby="join-cta-title">
        <div class="container join-cta__inner">
          <div>
            <p class="eyebrow">Potrzebujesz mediacji?</p>
            <h2 id="join-cta-title">Zgłoś swoją sprawę</h2>
            <p>Przejdź do formularza na stronie głównej i skontaktuj się z naszym Centrum Mediacji.</p>
          </div>
          <a class="button button--light" href="https://polskiebudownictwo.org/#dolacz">Przejdź do formularza</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container mediation-footer">
        <div class="mediation-footer__brand"><a class="site-logo site-logo--footer" href="https://polskiebudownictwo.org/" aria-label="Polskie Budownictwo"><img src="/assets/images/logo.png" alt="Polskie Budownictwo" /></a><p>Centrum Mediacji Gospodarczych przy Fundacji „Polskie Budownictwo”.</p></div>
        <div class="mediation-footer__column"><p class="mediation-footer__title">Kontakt ogólny</p><a href="mailto:mediacje@polskiebudownictwo.org">mediacje@polskiebudownictwo.org</a><address>ul. Nowogrodzka 50/54 lok. 515<br>00-695 Warszawa</address><address>al. Grunwaldzka 56 lok. 202<br>80-241 Gdańsk</address></div>
        <div class="mediation-footer__column"><p class="mediation-footer__title">Organizacja mediacji</p><p>Mediacje stacjonarne prowadzimy w salach przystosowanych dla 6-8 osób.</p><p>Posiedzenia mediacyjne organizujemy od poniedziałku do czwartku, 10:00-15:00.</p></div>
        <div class="mediation-footer__column"><p class="mediation-footer__title">Zgłoszenia i formy pracy</p><p>Prowadzimy mediacje stacjonarne, online, hybrydowe i wielostronne.</p><nav class="site-footer__links" aria-label="Dokumenty prawne"><a href="/wkrotce">Polityka prywatności</a><a href="/wkrotce">Polityka cookies</a></nav></div>
        <p class="mediation-footer__copyright">© 2026 Polskie Budownictwo. Wszelkie prawa zastrzeżone.</p>
      </div>
    </footer>
    <script src="/assets/js/menu.js?v=1" defer></script>
  </body>
</html>
