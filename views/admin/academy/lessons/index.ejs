<%- include('../../../partials/admin-shell-start', { title, admin }) %>
<section class="admin-page">
  <a class="button button--ghost" href="<%= module ? adminUrl('/academy/modules/' + module.id + '/edit') : adminUrl('/academy/courses/' + course.id + '/modules') %>">Wróć do <%= module ? 'modułu' : 'modułów' %></a>
  <div class="admin-hero"><div class="admin-hero__art" aria-hidden="true">L</div><div><p class="adm-kicker">Lekcje modułu</p><h1><%= module ? module.title : course.title %></h1><p class="admin-hero__meta">Zarządzaj kolejnością, blokami treści i publikacją.</p></div></div>
  <div class="adm-page-actions"><a class="button" href="<%= module ? adminUrl('/academy/modules/' + module.id + '/lessons/new') : adminUrl('/academy/courses/' + course.id + '/lessons/new') %>">Dodaj lekcję</a><a class="button button--ghost" href="<%= adminUrl('/academy/courses/' + course.id + '/edit') %>">Edytuj kurs</a></div>
  <div class="adm-table-panel"><%- include('../../../components/Table', { columns: [
    { label: 'Kolejność', value: lesson => lesson.sort_order },
    { label: 'Tytuł', value: lesson => lesson.title },
    { label: 'Slug', value: lesson => lesson.slug },
    { label: 'Status', value: lesson => lesson.is_published ? 'Opublikowany' : 'Szkic' },
    { label: 'Akcje', html: true, value: lesson => `<a class="button button--ghost" href="${adminUrl('/academy/lessons/' + lesson.id + '/edit')}">Edytuj</a>` },
  ], rows: lessons, emptyMessage: 'Brak lekcji.' }) %></div>
</section>
<%- include('../../../partials/admin-shell-end') %>
