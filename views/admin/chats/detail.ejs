<%- include('../../partials/admin-shell-start', { title, admin }) %>
<section class="admin-page">
  <a class="button button--ghost" href="<%= adminUrl('/chats') %>">Wróć do czatów</a>
  <div class="admin-hero"><div class="admin-hero__art" aria-hidden="true">C</div><div><p class="adm-kicker">Czat</p><h1><%= chat.title %></h1><p class="admin-hero__meta"><%= chat.is_active ? 'Aktywny' : 'Wyłączony' %> · <%= chat.access_type === 'course' ? `Kurs: ${chat.course_title || '-'}` : 'Lista uczestników' %></p></div></div>
  <div class="adm-card chat-detail"><dl class="adm-detail-list"><div><dt>UUID do osadzenia</dt><dd><code><%= chat.uuid %></code></dd></div><div><dt>Przykład osadzenia</dt><dd><code>&lt;%- include('../../../modules/chat/index', { uuid: '<%= chat.uuid %>' }) %&gt;</code></dd></div></dl><% if (admin.role === 'superadmin') { %><form class="affiliate-link-detail__actions" method="post" action="<%= adminUrl('/chats/' + chat.id + '/toggle') %>"><button class="button button--ghost" type="submit"><%= chat.is_active ? 'Wyłącz czat' : 'Włącz czat' %></button></form><% } %></div>
  <% if (chat.access_type === 'members') { %><section class="chat-admin-section"><h2 class="adm-section-title">Uczestnicy</h2><% if (admin.role === 'superadmin') { %><form class="toolbar" method="post" action="<%= adminUrl('/chats/' + chat.id + '/members') %>"><input name="email" type="email" placeholder="E-mail użytkownika" required><button class="button" type="submit">Dodaj uczestnika</button></form><% } %><div class="adm-table-panel"><%- include('../../components/Table', { columns: [{ label: 'Użytkownik', value: member => member.display_name }, { label: 'E-mail', value: member => member.email }, { label: 'Status', value: member => member.is_blocked ? 'Zablokowany' : 'Aktywny' }, { label: 'Akcje', html: true, value: member => admin.role === 'superadmin' ? `<form method="post" action="${adminUrl('/chats/' + chat.id + '/members/' + member.user_id + '/toggle-block')}"><button class="button button--ghost" type="submit">${member.is_blocked ? 'Odblokuj' : 'Zablokuj'}</button></form>` : '-' }], rows: members, emptyMessage: 'Nie dodano uczestników.' }) %></div></section><% } %>
  <section class="chat-admin-section"><h2 class="adm-section-title">Ostatnie wiadomości</h2><div class="adm-table-panel"><%- include('../../components/Table', { columns: [{ label: 'Autor', value: message => message.author_name }, { label: 'Treść', value: message => message.body }, { label: 'Data', value: message => new Date(message.created_at).toLocaleString('pl-PL') }, { label: 'Akcje', html: true, value: message => admin.role === 'superadmin' ? `<form class="chat-admin-actions" method="post" action="${adminUrl('/chats/' + chat.id + '/messages/' + message.id + '/block-author')}"><button class="button button--ghost" type="submit">Zablokuj autora</button></form><form class="chat-admin-actions" method="post" action="${adminUrl('/chats/' + chat.id + '/messages/' + message.id + '/delete')}" onsubmit="return confirm('Usunąć tę wiadomość?');"><button class="button button--ghost" type="submit">Usuń</button></form>` : '-' }], rows: messages, emptyMessage: 'Brak wiadomości.' }) %></div></section>
</section>
<%- include('../../partials/admin-shell-end') %>
