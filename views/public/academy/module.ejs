<!doctype html>
<html lang="pl">
  <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="robots" content="noindex, nofollow"><title><%= title %> | Akademia</title><link rel="stylesheet" href="/global.css"><link rel="stylesheet" href="/assets/css/academy/modules/courseList.css"><link rel="stylesheet" href="/assets/css/academy/modules/coursePlayer.css"></head>
  <body class="academy-page academy-course-page"><header class="site-header"><div class="container site-header__inner"><a class="site-logo" href="/akademia/"><img src="/assets/images/logo.png" alt="Polskie Budownictwo"></a><nav class="site-nav"><a href="/akademia/">Dostępne szkolenia</a><a href="/akademia/ustawienia/">Ustawienia konta</a><a href="/o_fundacji.html">O fundacji</a></nav></div></header>
    <main class="academy-detail"><section class="section section--dark academy-courses__hero"><div class="container"><p class="eyebrow"><%= course.title %></p><h1><%= module.title %></h1><p class="lead"><%= module.description || 'Wybierz lekcję, aby rozpocząć naukę.' %></p></div></section><section class="section"><div class="container academy-detail__content"><a class="button button--ghost" href="/akademia/kurs/<%= encodeURIComponent(course.slug) %>">← Wróć do szkolenia</a><div class="academy-module-lessons"><p class="eyebrow">Program modułu</p><h2>Lekcje</h2><% if (!lessons.length) { %><p>Ten moduł nie ma jeszcze opublikowanych lekcji.</p><% } else { %><ol class="academy-module-lessons__list"><% lessons.forEach((lesson, index) => { %><li><a href="/akademia/kurs/<%= encodeURIComponent(course.slug) %>/modul/<%= encodeURIComponent(module.slug) %>/lekcja/<%= encodeURIComponent(lesson.slug) %>"><span><%= index + 1 %></span><strong><%= lesson.title %></strong><small><%= lesson.description || 'Otwórz lekcję' %></small></a></li><% }) %></ol><% } %></div></div></section></main>
  </body>
</html>
