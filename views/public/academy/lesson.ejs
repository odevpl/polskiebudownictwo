<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= title %> | Akademia</title>
    <link rel="stylesheet" href="/global.css">
    <link rel="stylesheet" href="/assets/css/academy/modules/courseList.css">
    <link rel="stylesheet" href="/assets/css/academy/modules/coursePlayer.css">
    <link rel="stylesheet" href="/assets/css/academy/modules/lessonView.css">
    <link rel="stylesheet" href="/assets/css/academy/modules/lessonProgress.css">
    <link rel="stylesheet" href="/assets/css/academy/modules/lessonNavigation.css">
  </head>
  <body class="academy-page academy-course-page">
    <header class="site-header"><div class="container site-header__inner"><a class="site-logo" href="/akademia/" aria-label="Akademia Polskiego Budownictwa"><img src="/assets/images/logo.png" alt="Polskie Budownictwo"></a><nav class="site-nav" aria-label="Główna nawigacja"><a href="/akademia/">Dostępne kursy</a><a href="/akademia/ustawienia/">Ustawienia konta</a><a href="/o_fundacji.html">O fundacji</a></nav></div></header>
    <main class="academy-detail">
      <section class="section section--dark academy-courses__hero"><div class="container"><p class="eyebrow"><%= course.title %></p><h1><%= lesson.title %></h1><p class="lead"><%= lesson.description || '' %></p></div></section>
      <section class="section"><div class="container academy-detail__content"><div class="academy-course-player"><%- include('./modules/courseList/index', { lessons, activeLessonId: lesson.id, course }) %><div class="academy-course-player__content"><%- include('./modules/lessonView/index', { lesson }) %><%- include('./modules/lessonProgress/index', { lesson, progress }) %><%- include('./modules/lessonNavigation/index', { course, previousLesson: lessons[lessons.findIndex(item => item.id === lesson.id) - 1] || null, nextLesson: lessons[lessons.findIndex(item => item.id === lesson.id) + 1] || null }) %></div></div></div></section>
    </main>
    <script src="/assets/js/menu.js?v=3" defer></script><script src="/assets/js/academy/modules/lessonProgress.js" defer></script>
  </body>
</html>
