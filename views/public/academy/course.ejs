<!doctype html>
<html lang="pl">
  <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="robots" content="noindex, nofollow"><title><%= title %> | Akademia</title><link rel="stylesheet" href="/global.css"><link rel="stylesheet" href="/assets/css/academy/modules/courseCards.css"></head>
  <body class="academy-page academy-course-page">
    <header class="site-header"><div class="container site-header__inner"><a class="site-logo" href="/akademia/" aria-label="Akademia Polskiego Budownictwa"><img src="/assets/images/logo.png" alt="Polskie Budownictwo"></a><nav class="site-nav" aria-label="Główna nawigacja"><a href="/akademia/">Dostępne szkolenia</a><a href="/akademia/ustawienia/">Ustawienia konta</a><a href="/o_fundacji.html">O fundacji</a></nav></div></header>
    <main class="academy-detail"><section class="section section--dark academy-courses__hero"><div class="container"><p class="eyebrow"><%= course.category || 'Akademia' %></p><h1><%= course.title %></h1><div class="lead academy-rich-text"><%- richText(course.description) %></div></div></section><section class="section"><div class="container academy-detail__content"><a class="button button--ghost" href="/akademia/">← Wróć do szkoleń</a><header class="academy-section-heading"><p class="eyebrow">Program szkolenia</p><h2>Moduły</h2></header><div class="academy-module-grid"><% if (!modules.length) { %><p>To szkolenie nie ma jeszcze opublikowanych modułów.</p><% } %><% modules.forEach((item, index) => { %><a class="academy-module-card" href="/akademia/kurs/<%= encodeURIComponent(course.slug) %>/modul/<%= encodeURIComponent(item.slug) %>"><span class="academy-module-card__number"><%= index + 1 %></span><strong><%= item.title %></strong><span><%= item.published_lesson_count || 0 %> lekcji</span><% if (item.description) { %><div class="academy-rich-text"><%- richText(item.description) %></div><% } %></a><% }) %></div></div></section></main>
  </body>
</html>
