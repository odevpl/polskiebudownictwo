<!doctype html>
<html lang="pl">
  <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="robots" content="noindex, nofollow"><title><%= title %> | Akademia</title><link rel="stylesheet" href="/global.css"><link rel="stylesheet" href="/assets/css/academy/modules/courseCards.css"></head>
  <body class="academy-page academy-course-page">
    <header class="site-header"><div class="container site-header__inner"><a class="site-logo" href="/akademia/" aria-label="Akademia Polskiego Budownictwa"><img src="/assets/images/logo.png" alt="Polskie Budownictwo"></a><nav class="site-nav" aria-label="Główna nawigacja"><a href="/akademia/">Dostępne szkolenia</a><a href="/akademia/ustawienia/">Ustawienia konta</a><a href="/o_fundacji.html">O fundacji</a></nav></div></header>
    <main class="academy-detail"><section class="section section--dark academy-courses__hero"><div class="container"><p class="eyebrow"><%= course.category || 'Akademia' %></p><h1><%= course.title %></h1><div class="lead academy-rich-text"><%- richText(course.description) %></div></div></section><section class="section"><div class="container academy-detail__content"><a class="button button--ghost" href="/akademia/">← Wróć do szkoleń</a><section class="academy-modules-list" aria-labelledby="academy-modules-title"><h2 id="academy-modules-title">Moduły</h2><% if (!modules.length) { %><p class="academy-modules-list__empty">To szkolenie nie ma jeszcze opublikowanych modułów.</p><% } else { %><ol><% modules.forEach((item, index) => { %><li><a href="/akademia/kurs/<%= encodeURIComponent(course.slug) %>/modul/<%= encodeURIComponent(item.slug) %>"><span class="academy-modules-list__number"><%= index + 1 %></span><span class="academy-modules-list__title"><%= item.title %></span><span class="academy-modules-list__arrow" aria-hidden="true">→</span></a></li><% }) %></ol><% } %></section></div></section></main>
  </body>
</html>
