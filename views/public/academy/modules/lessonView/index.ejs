<article class="lesson-view-module" data-lesson-view>
  <% const hasCustomLessonTitle = lesson.contentBlocks?.some(block => block.type === 'lessonTitle'); %>
  <div class="lesson-view-module__intro">
    <% if (!hasCustomLessonTitle) { %><h1><%= lesson.title %></h1><% } %>
  </div>
  <div class="lesson-view-module__body">
    <% if (lesson.contentBlocks && lesson.contentBlocks.length) { %>
      <% lesson.contentBlocks.forEach(block => { %>
        <% if (block.type === 'richText') { %><%- include('../contentBlock/richText', { block }) %><% } %>
        <% if (block.type === 'youtube') { %><%- include('../contentBlock/youtube', { block }) %><% } %>
        <% if (block.type === 'files') { %><%- include('../contentBlock/files', { block }) %><% } %>
        <% if (block.type === 'lessonTitle') { %><%- include('../contentBlock/lessonTitle', { lesson }) %><% } %>
      <% }) %>
    <% } else { %><p>Treść modułu zostanie dodana.</p><% } %>
  </div>
</article>
