# MailerLite API
MAILERLITE_API_TOKEN=
# Opcjonalne; domyślnie: https://connect.mailerlite.com/api
MAILERLITE_API_URL=https://connect.mailerlite.com/api
# Opcjonalne; domyślnie 30000 ms
MAILERLITE_SYNC_INTERVAL_MS=30000
# Adres API głównej domeny wykorzystywany przez aplikację mediacji
MEDIATION_API_URL=https://polskiebudownictwo.org
# Tymczasowe obejście płatności: aktywuje zakup lokalnie bez operatora.
PAYMENT_BYPASS_ENABLED=0
# Google reCAPTCHA v2 Checkbox — klucz publiczny może być używany w frontendzie, sekret tylko po stronie serwera.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=1
BLOCKED_EMAIL_DOMAINS=
UNVERIFIED_USER_RETENTION_HOURS=48
