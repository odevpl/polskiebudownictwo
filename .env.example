# MailerLite API — synchronizacja działa wyłącznie przy NODE_ENV=production.
MAILERLITE_API_TOKEN=
# Opcjonalne; domyślnie: https://connect.mailerlite.com/api
MAILERLITE_API_URL=https://connect.mailerlite.com/api
# Opcjonalne; domyślnie 30000 ms
MAILERLITE_SYNC_INTERVAL_MS=30000
# Adres API głównej domeny wykorzystywany przez aplikację mediacji
MEDIATION_API_URL=https://polskiebudownictwo.org
# Tymczasowe obejście płatności: aktywuje zakup lokalnie bez operatora.
PAYMENT_BYPASS_ENABLED=0
# Google reCAPTCHA v2 Checkbox — klucz publiczny może być używany w frontendzie, sekret tylko po stronie serwera.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=1
BLOCKED_EMAIL_DOMAINS=
UNVERIFIED_USER_RETENTION_HOURS=48

# Prywatny magazyn plików: na produkcji bezwzględna ścieżka poza katalogiem aplikacji.
# Puste lokalnie oznacza storage/files (poza katalogami publicznymi).
UPLOAD_STORAGE_PATH=
UPLOAD_MAX_BYTES=20971520
UPLOAD_LESSON_FILES=10
UPLOAD_LESSON_BYTES=104857600
UPLOAD_MAX_BLOCKS=50
UPLOAD_TEMP_FILES=30
UPLOAD_TEMP_BYTES=209715200
UPLOAD_STORAGE_BYTES=5368709120
UPLOAD_TEMP_HOURS=24
UPLOAD_TIMEOUT_MS=120000
UPLOAD_MAX_PIXELS=25000000
UPLOAD_CONCURRENT_FILES=4
UPLOAD_ADMIN_CONCURRENT_FILES=2
# DOCX jest opcjonalny i domyślnie wyłączony.
UPLOAD_DOCX_ENABLED=0
